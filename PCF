import argparse
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

POSTCODE_RE = re.compile(r"\b([A-Za-z]{1,2}\d[A-Za-z\d]?\s*\d[A-Za-z]{2})\b")


def extract_postcodes(raw_text: str) -> list[str]:
    seen = set()
    results = []
    for match in POSTCODE_RE.finditer(raw_text):
        cleaned = re.sub(r"\s+", "", match.group(1)).upper()
        if cleaned not in seen:
            seen.add(cleaned)
            results.append(cleaned)
    return results


def format_postcode(compact: str) -> tuple[str, str, str, str, str]:
    outcode, incode = compact[:-3], compact[-3:]
    formatted = f"{outcode} {incode}"
    slug = f"{outcode.lower()}-{incode.lower()}"
    double_slug = f"{outcode.lower()}--{incode.lower()}"
    return formatted, compact, slug, double_slug, outcode


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def fetch_j2(compact_pc: str) -> dict:
    url = f"https://api.postcodes.io/postcodes/{urllib.parse.quote(compact_pc)}"
    req = urllib.request.Request(url, headers={"User-Agent": "PCodeRecce-pcf/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=6) as resp:
            payload = json.loads(resp.read().decode("utf-8"))
            if payload.get("status") == 200 and payload.get("result"):
                return payload["result"]
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        pass
    return {}


def build_links(formatted: str, slug: str, double_slug: str, outcode: str, j2: dict) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    district = j2.get("admin_district") or ""
    district_slug = slugify(district) if district else "uk"
    loopnet_loc = f"{district_slug}-rcc-{outcode.lower()}--united-kingdom" if district else f"{outcode.lower()}--united-kingdom"
    novaloca_loc = urllib.parse.quote_plus(formatted.lower())

    residential = [
        ("Rightmove Sold Prices", f"https://www.rightmove.co.uk/house-prices/{slug}.html"),
        ("OnTheMarket Map-List", f"https://www.onthemarket.com/for-sale/property/{slug}/?view=map-list"),
        ("Zoopla House Prices", f"https://www.zoopla.co.uk/house-prices/{slug}/"),
    ]

    commercial = [
        ("LoopNet Commercial", f"https://www.loopnet.co.uk/search/commercial-property/{loopnet_loc}/for-rent/?keyword={double_slug}"),
        ("NovaLoca Commercial", f"https://www.novaloca.com/property-search-results/default.aspx?location={novaloca_loc}&distance=10&status=1"),
        ("Rightmove Commercial", f"https://www.rightmove.co.uk/commercial-property-to-let/{outcode}.html"),
    ]

    return residential, commercial


def render_target(compact: str, open_browser: bool) -> None:
    formatted, compact, slug, double_slug, outcode = format_postcode(compact)
    j2 = fetch_j2(compact)
    residential, commercial = build_links(formatted, slug, double_slug, outcode, j2)

    if j2:
        parish = j2.get("parish") or ""
        if "unparished" in parish.lower():
            parish = ""
        parts = [formatted] + [p for p in (j2.get("admin_ward"), parish, j2.get("admin_district")) if p]
        deduped = []
        for p in parts:
            if not deduped or deduped[-1].lower() != p.lower():
                deduped.append(p)
        print(f"\n  (P)CODE : {' | '.join(deduped)}\n")
        print(f"  LAT LNG : {j2.get('latitude')}, {j2.get('longitude')}")
        print(f"  OS GRID : {j2.get('eastings')}, {j2.get('northings')}\n")
    else:
        print(f"\n  (P)CODE : {formatted}\n")

    for label, url in residential:
        print(f"  > {label:<24} {url}")
    print()
    for label, url in commercial:
        print(f"  > {label:<24} {url}")
    print()

    if open_browser:
        for _, url in residential:
            webbrowser.open_new_tab(url)


def run_targets(targets: list[str], open_browser: bool) -> None:
    for idx, compact in enumerate(targets):
        if idx > 0:
            print("  " + "-" * 60)
        render_target(compact, open_browser)


def interactive_loop(open_browser: bool) -> None:
    while True:
        try:
            line = input("\n  PCODE , (E)XIT : ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break

        if not line:
            continue
        if line.lower() in {"e", "exit", "q", "quit"}:
            break

        targets = extract_postcodes(line)
        if not targets:
            print("  ! No valid UK postcode detected.")
            continue

        run_targets(targets, open_browser)


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("postcodes", nargs="*")
    parser.add_argument("--open", action="store_true")
    args, _ = parser.parse_known_args()

    chunks = list(args.postcodes)
    if not sys.stdin.isatty():
        piped = sys.stdin.read()
        if piped.strip():
            chunks.append(piped)

    raw_blob = " ".join(chunks).strip()
    if not raw_blob:
        interactive_loop(args.open)
        return

    targets = extract_postcodes(raw_blob)
    if not targets:
        print("  ! No valid UK postcode detected.", file=sys.stderr)
        sys.exit(1)

    run_targets(targets, args.open)


if __name__ == "__main__":
    main()
